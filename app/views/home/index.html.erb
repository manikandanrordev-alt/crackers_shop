<!-- Luxury Font: Cinzel & Playfair Display -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

<style>
  :root {
    /* Downgraded Gold -> Champagne/Sand */
    --gold-primary: #C5A059; 
    --gold-light: #E0C080;
    --gold-dark: #8C7035;
    /* Downgraded Cream -> Soft Cloud/Alabaster */
    --cream-bg: #FAFAFA;
    --text-main: #444444;
  }
  
  body {
    background-color: var(--cream-bg);
    color: var(--text-main);
    font-family: 'Playfair Display', serif; /* More casual/approachable as primary */
  }

  h1, h2, h3, h4, h5 {
    font-family: 'Cinzel', serif; /* Keep headers distinct */
    color: #2c2c2c;
  }

  .text-gold { color: var(--gold-primary) !important; }
  .bg-gold { background-color: var(--gold-primary) !important; color: #fff; }
  .bg-cream { background-color: #F5F5F0 !important; } /* Slightly darker visual break */
  
  /* Gradient Text: Softer */
  .text-gradient-gold {
     background: linear-gradient(to right, var(--gold-dark), var(--gold-primary), var(--gold-dark));
     -webkit-background-clip: text;
     -webkit-text-fill-color: transparent;
  }
  
  /* Buttons: Rounded & Soft */
  .btn-gold {
    background: linear-gradient(135deg, var(--gold-primary), var(--gold-dark));
    color: white;
    border: none;
    border-radius: 50px; /* Full pill shape */
    padding: 12px 30px;
    box-shadow: 0 4px 15px rgba(197, 160, 89, 0.3);
    transition: all 0.3s ease;
  }
  .btn-gold:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(197, 160, 89, 0.4);
    color: white;
  }
  
  .btn-outline-gold {
    border: 2px solid var(--gold-primary);
    color: var(--gold-primary);
    background: transparent;
    border-radius: 50px;
    padding: 10px 30px;
    transition: all 0.3s ease;
  }
  .btn-outline-gold:hover {
    background: var(--gold-primary);
    color: white;
    box-shadow: 0 4px 15px rgba(197, 160, 89, 0.2);
  }
  
  /* Cards: Floating, No Borders */
  .card-custom {
    border: none;
    border-radius: 20px; /* Rounded corners */
    background: white;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05); /* Soft float shadow */
    transition: all 0.4s ease;
    overflow: hidden;
  }
  .card-custom:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(197, 160, 89, 0.15); /* Champagne glow on hover */
  }

  /* Soft Inputs/Forms if needed later */
  .form-control {
    border-radius: 15px;
    border: 1px solid #eee;
    background-color: #fafafa;
  }
  
  .img-wrapper {
    transition: transform 0.5s ease;
  }
  .card-custom:hover .img-wrapper {
    transform: scale(1.05);
  }
</style>

<div class="home-page overflow-hidden">
  
  <!-- Hero Carousel -->
  <div id="heroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="3000">
    <div class="carousel-indicators">
      <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" style="background-color: var(--gold-primary); width: 10px; height: 10px; border-radius: 50%; margin: 0 5px;"></button>
      <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" style="background-color: var(--gold-primary); width: 10px; height: 10px; border-radius: 50%; margin: 0 5px;"></button>
      <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" style="background-color: var(--gold-primary); width: 10px; height: 10px; border-radius: 50%; margin: 0 5px;"></button>
    </div>
    <div class="carousel-inner rounded-bottom-5" style="border-radius: 0 0 50px 50px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.05);"> 
       <!-- Soft curve at bottom of carousel -->
       
      <!-- Slide 1: User Image (Raksh Crackers) - CONTAIN FIT -->
      <div class="carousel-item active" style="height: 85vh; background-color: #1a1a1a;">
        <%= image_tag "hero_1.jpg", class: "d-block w-100 h-100", alt: "Raksh Crackers", style: "object-fit: contain;" %>
        <div class="carousel-caption d-none d-md-block bottom-0 text-center w-100 pb-5" style="background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);">
          <%= link_to "Explore Collection", products_path, class: "btn btn-gold btn-lg px-5 animate__animated animate__fadeInUp" %>
        </div>
      </div>
      
      <!-- Slide 2 -->
      <div class="carousel-item" style="height: 85vh;">
        <%= image_tag "hero_2.jpg", class: "d-block w-100 h-100 object-fit-cover", alt: "Sparklers", style: "object-fit: cover;" %>
        <div class="carousel-caption d-none d-md-block top-50 start-50 translate-middle text-center w-75 p-5 rounded-5" style="background: rgba(255,255,255,0.9); box-shadow: 0 15px 40px rgba(0,0,0,0.1); backdrop-filter: blur(5px);">
          <h1 class="display-3 fw-bold text-gradient-gold animate__animated animate__fadeInDown text-uppercase">Pure Elegance</h1>
          <p class="fs-4 text-muted animate__animated animate__fadeInUp fst-italic mt-3">"Safer, Brighter, Better"</p>
          <%= link_to "View Collection", products_path, class: "btn btn-outline-gold btn-lg px-5 mt-4 fw-bold" %>
        </div>
      </div>
      
      <!-- Slide 3 -->
      <div class="carousel-item" style="height: 85vh;">
        <%= image_tag "hero_3.jpg", class: "d-block w-100 h-100 object-fit-cover", alt: "Grand Finale", style: "object-fit: cover;" %>
        <div class="carousel-caption d-none d-md-block top-50 start-50 translate-middle text-center w-75 p-5 rounded-5" style="background: rgba(255,255,255,0.9); box-shadow: 0 15px 40px rgba(0,0,0,0.1); backdrop-filter: blur(5px);">
          <h1 class="display-3 fw-bold text-gradient-gold animate__animated animate__fadeInDown text-uppercase">Wholesale Prices</h1>
          <p class="fs-4 text-muted animate__animated animate__fadeInUp fst-italic mt-3">"Direct from Sivakasi to your Doorstep"</p>
          <%= link_to "Order Now", products_path, class: "btn btn-gold btn-lg px-5 mt-4 fw-bold" %>
        </div>
      </div>
    </div>
    
    <!-- Soft Controls -->
    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev" style="width: 5%;">
      <span class="carousel-control-prev-icon bg-secondary rounded-circle p-3 bg-opacity-25" aria-hidden="true"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next" style="width: 5%;">
      <span class="carousel-control-next-icon bg-secondary rounded-circle p-3 bg-opacity-25" aria-hidden="true"></span>
    </button>
  </div>

  <!-- Shop By Category Section -->
  <section class="py-5 bg-white">
    <div class="container py-5">
      <div class="text-center mb-5">
        <span class="text-gold text-uppercase fw-bold small tracking-wide">Browse Our Store</span>
        <h2 class="display-4 fw-bold mt-2">Our Collections</h2>
        <div class="divider mx-auto bg-gold opacity-50 rounded-pill" style="width: 80px; height: 4px; margin-top: 1rem;"></div>
      </div>
      
      <div class="row g-4 justify-content-center">
        <!-- Loop for categories -->
        <% ['Sparklers', 'Rockets', 'Flower Pots', 'Gift Boxes'].each do |cat| %>
          <% 
             image = case cat
                     when 'Sparklers' then 'cat_sparklers.jpg'
                     when 'Rockets' then 'cat_rockets.jpg'
                     when 'Flower Pots' then 'cat_flowerpots.jpg'
                     when 'Gift Boxes' then 'cat_giftbox.jpg'
                     end
          %>
          <div class="col-6 col-md-3">
             <%= link_to products_path(category: cat), class: "text-decoration-none" do %>
               <div class="card-custom h-100 text-center p-4">
                  <div class="img-wrapper mx-auto mb-3 rounded-circle shadow-sm overflow-hidden" style="width: 140px; height: 140px;">
                     <%= image_tag image, class: "w-100 h-100 object-fit-contain", alt: cat %>
                  </div>
                  <h5 class="fw-bold mt-3 text-dark"><%= cat %></h5>
                  <span class="text-gold small fw-bold">Shop Now <i class="fas fa-arrow-right ms-1"></i></span>
               </div>
             <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
