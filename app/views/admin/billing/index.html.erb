<div class="container-fluid" data-controller="billing">
  <div class="row">
    <div class="col-md-7">
      <div class="card shadow mb-4">
        <div class="card-header py-3">
          <h6 class="m-0 font-weight-bold text-primary">Products</h6>
          <input type="text" class="form-control mt-2" placeholder="Search Products..." data-action="input->billing#search" autofocus>
        </div>
        <div class="card-body" style="height: 700px; overflow-y: auto;">
          <div id="product-list" class="row">
            <%= render partial: "product_list", locals: { products: @products } %>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-5">
      <div class="card shadow mb-4 border-left-success">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
          <h6 class="m-0 font-weight-bold text-success">New Bill</h6>
          <button class="btn btn-sm btn-outline-danger" data-action="click->billing#clearCart">Clear</button>
        </div>
        <div class="card-body">
          <div id="empty-state" class="text-center py-5">
            <i class="fas fa-shopping-basket fa-4x text-gray-300 mb-3"></i>
            <p class="text-muted">Cart is empty. Add products to start billing.</p>
          </div>

          <div id="bill-items-container" class="d-none">
             <div id="bill-items" style="height: 250px; overflow-y: auto;" class="mb-3 border-bottom">
               <!-- Items will be added here via JS -->
             </div>
             
             <div class="d-flex justify-content-between mb-2">
                <span>Subtotal:</span>
                <span class="font-weight-bold" id="subtotal-amount">₹0.00</span>
             </div>

             <div class="input-group mb-3">
               <span class="input-group-text">Discount %</span>
               <input type="number" id="discount-percentage" class="form-control" value="0" min="0" max="100" data-action="input->billing#calculateTotal">
             </div>

             <div class="d-flex justify-content-between mb-3">
                <h5 class="text-success">Total Payable:</h5>
                <h5 class="text-success font-weight-bold" id="total-amount">₹0.00</h5>
             </div>
             
             <hr>

             <div class="mb-2">
               <input type="text" id="customer-name" class="form-control mb-2" placeholder="Customer Name">
               <input type="text" id="customer-phone" class="form-control mb-2" placeholder="Phone Number">
               <textarea id="customer-address" class="form-control mb-2" placeholder="Address" rows="2"></textarea>
               <input type="email" id="customer-email" class="form-control mb-2" placeholder="Email (Optional)">
             </div>

             <div class="mb-3">
                <label>Payment Method</label>
                <select id="payment-method" class="form-select">
                   <option value="cash">Cash</option>
                   <option value="card">Card</option>
                   <option value="upi">UPI</option>
                </select>
             </div>

             <button class="btn btn-success btn-block mt-3 w-100 py-3 font-weight-bold" data-action="click->billing#checkout">
               <i class="fas fa-print mr-2"></i> Complete Order & Print
             </button>
           </div>
        </div>
      </div>
    </div>
  </div>
</div>
