<!DOCTYPE html>
<html>
  <head>
    <title>Raksh Crackers | Best Fireworks Shop</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <% config = ShopConfig.first %>
    <% if config&.logo&.attached? %>
      <%= favicon_link_tag url_for(config.logo) %>
    <% else %>
      <%= favicon_link_tag "data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🚀</text></svg>" %>
    <% end %>

    <!-- Bootstrap CSS (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
      .floating-socials {
        position: fixed;
        top: 50%;
        right: 20px;
        transform: translateY(-50%);
        z-index: 1000;
        display: flex;
        flex-direction: column;
        gap: 15px;
      }
      .social-btn {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        text-decoration: none;
        font-size: 24px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        transition: transform 0.3s, box-shadow 0.3s;
      }
      .social-btn:hover {
        transform: scale(1.1);
        box-shadow: 0 6px 8px rgba(0,0,0,0.2);
        color: white;
      }
      .btn-whatsapp { background-color: #25D366; }
      .btn-instagram { background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%); }
      .btn-facebook { background-color: #1877F2; }
    </style>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm sticky-top">
      <div class="container">
        <a class="navbar-brand fw-bold text-uppercase" href="/">
          <% if ShopConfig.first&.logo&.attached? %>
            <%= image_tag ShopConfig.first.logo, style: "height: 40px; margin-right: 10px;", class: "d-inline-block align-top" %>
          <% else %>
            🚀 
          <% end %>
          <%= ShopConfig.first&.shop_name || "Raksh Crackers" %>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item"><a class="nav-link <%= 'active' if current_page?(root_path) %>" href="/">Home</a></li>
            <li class="nav-item"><a class="nav-link <%= 'active' if current_page?(products_path) %>" href="<%= products_path %>">Crackers</a></li>
            <li class="nav-item"><%= link_to "Contact Us", root_path(anchor: "contact"), class: "nav-link" %></li>
            
            <% if user_signed_in? %>
              <% if current_page?(products_path) || request.path.include?('/cart') %>
                <li class="nav-item">
                  <%= link_to cart_path, class: "nav-link position-relative" do %>
                     <i class="fas fa-shopping-cart"></i> Cart
                  <% end %>
                </li>
              <% end %>
              
              <% if current_user.admin? %>
                <li class="nav-item"><%= link_to "Admin Panel", admin_root_path, class: "nav-link text-warning" %></li>
              <% end %>
              <li class="nav-item"><%= link_to "Logout", destroy_user_session_path, data: { turbo_method: :delete }, class: "nav-link" %></li>
            <% else %>
              <li class="nav-item"><%= link_to "Login", new_user_session_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "Sign Up", new_user_registration_path, class: "nav-link btn btn-primary text-white ms-2 px-3" %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <%= yield %>

    <footer class="bg-dark text-white text-center py-4 mt-5">
      <div class="container">
        <p>&copy; <%= Time.current.year %> Raksh Crackers. All Rights Reserved.</p>
        <div class="mt-3">
          <% if config = ShopConfig.first %>
            <% if config.whatsapp_number.present? %>
              <a href="https://wa.me/<%= config.whatsapp_number %>" target="_blank" class="text-white me-3 fs-5"><i class="fab fa-whatsapp"></i></a>
            <% end %>
            <% if config.instagram_url.present? %>
              <a href="<%= config.instagram_url %>" target="_blank" class="text-white me-3 fs-5"><i class="fab fa-instagram"></i></a>
            <% end %>
            <% if config.facebook_url.present? %>
              <a href="<%= config.facebook_url %>" target="_blank" class="text-white fs-5"><i class="fab fa-facebook"></i></a>
            <% end %>
          <% end %>
        </div>
        <p class="small text-muted mt-3">Made with 💥 for Diwali.</p>
      </div>
    </footer>
    <%= render "shared/confirmation_modal" %>
    <%= render "shared/login_modal" %>
    
    <!-- Floating Social Icons -->
    <% config = ShopConfig.first %>
    <div class="floating-socials">
      <% if config&.whatsapp_number.present? %>
         <a href="https://wa.me/<%= config.whatsapp_number %>" target="_blank" class="social-btn btn-whatsapp" title="Chat on WhatsApp">
           <i class="fab fa-whatsapp"></i>
         </a>
      <% end %>

      <% if config&.instagram_url.present? %>
         <a href="<%= config.instagram_url %>" target="_blank" class="social-btn btn-instagram" title="Follow on Instagram">
           <i class="fab fa-instagram"></i>
         </a>
      <% end %>

      <% if config&.facebook_url.present? %>
         <a href="<%= config.facebook_url %>" target="_blank" class="social-btn btn-facebook" title="Follow on Facebook">
           <i class="fab fa-facebook-f"></i>
         </a>
      <% end %>
    </div>
  </body>
</html>