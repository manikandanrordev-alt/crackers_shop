<!DOCTYPE html>
<html>
  <head>
    <title>Raksh Admin | Luxury Dashboard</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">

    <!-- Bootstrap CSS (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    
    <style>
      :root {
        --admin-sidebar-bg: #1a1a1a;
        --admin-sidebar-text: #a0a0a0;
        --admin-gold: #D4AF37;
        --admin-bg: #f4f6f9;
      }
      
      body {
        font-family: 'Inter', sans-serif;
        background-color: var(--admin-bg);
      }
      
      /* Sidebar Styling */
      .sidebar {
        min-height: 100vh;
        background-color: var(--admin-sidebar-bg);
        color: var(--admin-sidebar-text);
        transition: width 0.3s;
        box-shadow: 2px 0 10px rgba(0,0,0,0.1);
      }
      
      .sidebar-brand {
        height: 5rem;
        text-decoration: none;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        border-bottom: 1px solid rgba(255,255,255,0.05);
      }
      
      .sidebar-brand-text {
        font-family: 'Cinzel', serif;
        font-weight: 700;
        letter-spacing: 1px;
        color: var(--admin-gold);
      }
      
      .sidebar .nav-link {
        color: var(--admin-sidebar-text);
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: all 0.2s;
        border-right: 3px solid transparent;
      }
      
      .sidebar .nav-link:hover {
        color: white;
        background: rgba(255,255,255,0.02);
      }
      
      .sidebar .nav-link.active {
        color: white;
        background: linear-gradient(90deg, rgba(212, 175, 55, 0.1), transparent);
        border-right-color: var(--admin-gold);
      }
      
      .sidebar .nav-link i {
        width: 20px;
        text-align: center;
        transition: color 0.2s;
      }
      
      .sidebar .nav-link.active i, .sidebar .nav-link:hover i {
        color: var(--admin-gold);
      }
      
      .sidebar-divider {
        margin: 1rem 1.5rem;
        border-top: 1px solid rgba(255,255,255,0.05);
      }
      
      .content-wrapper {
        width: 100%;
        overflow-x: hidden;
      }
      
      /* Topbar */
      .topbar {
        background: white;
        border-bottom: 1px solid #eee;
        height: 4.375rem;
      }
      
      .admin-card {
        background: white;
        border: none;
        box-shadow: 0 2px 15px rgba(0,0,0,0.03);
        border-radius: 12px;
        transition: transform 0.2s;
      }
      .admin-card:hover {
        transform: translateY(-2px);
      }
      
      .sidebar.toggled { width: 80px !important; }
      .sidebar.toggled .nav-link span { display: none; }
      .sidebar.toggled .sidebar-brand-text { display: none; }
    </style>
    
    <script>
      function toggleSidebar() {
         const sidebar = document.getElementById('accordionSidebar');
         sidebar.classList.toggle('toggled');
      }
    </script>
  </head>

  <body>
    <div class="d-flex" id="wrapper">
      <!-- Sidebar -->
      <ul class="navbar-nav sidebar accordion" id="accordionSidebar" style="width: 260px;">
        <a class="sidebar-brand" href="/admin">
          <% if ShopConfig.first&.logo&.attached? %>
            <%= image_tag ShopConfig.first.logo, style: "width: 35px; height: 35px; border-radius: 50%; object-fit: cover; border: 1px solid var(--admin-gold);" %>
          <% else %>
             <i class="fas fa-rocket text-white"></i>
          <% end %>
          <div class="sidebar-brand-text mx-3">RAKSH ADMIN</div>
        </a>

        <div class="mt-3"></div>

        <li class="nav-item <%= 'active' if controller_name == 'dashboard' %>">
          <%= link_to admin_root_path, class: "nav-link" do %>
            <i class="fas fa-fw fa-tachometer-alt"></i>
            <span>Dashboard</span>
          <% end %>
        </li>

        <li class="nav-item <%= 'active' if controller_name == 'orders' %>">
           <%= link_to admin_orders_path, class: "nav-link" do %>
             <i class="fas fa-fw fa-shopping-bag"></i>
             <span>Orders</span>
           <% end %>
        </li>
        
        <li class="nav-item <%= 'active' if controller_name == 'billing' %>">
           <%= link_to admin_billing_path, class: "nav-link" do %>
             <i class="fas fa-fw fa-cash-register"></i>
             <span>Fast Billing</span>
           <% end %>
        </li>

        <div class="sidebar-divider"></div>

        <li class="nav-item <%= 'active' if controller_name == 'products' %>">
          <%= link_to admin_products_path, class: "nav-link" do %>
            <i class="fas fa-fw fa-box"></i>
            <span>Products</span>
          <% end %>
        </li>

        <li class="nav-item <%= 'active' if controller_name == 'users' %>">
           <%= link_to admin_users_path, class: "nav-link" do %>
             <i class="fas fa-fw fa-users"></i>
             <span>Customers</span>
           <% end %>
        </li>

        <div class="sidebar-divider"></div>

         <li class="nav-item <%= 'active' if controller_name == 'shop_configs' %>">
           <%= link_to admin_shop_config_path, class: "nav-link" do %>
             <i class="fas fa-fw fa-cog"></i>
             <span>Settings</span>
           <% end %>
        </li>
        
        <div class="mt-auto mb-4 text-center">
             <button class="btn btn-sm btn-outline-secondary border-0 text-muted" id="sidebarToggle" onclick="toggleSidebar()">
               <i class="fas fa-bars"></i> Collapse
            </button>
        </div>
      </ul>

      <!-- Content Wrapper -->
      <div id="content-wrapper" class="d-flex flex-column content-wrapper">
        <div id="content">
          <!-- Topbar -->
          <nav class="navbar navbar-expand topbar mb-4 static-top px-4">
             <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3 text-dark" onclick="toggleSidebar()">
                <i class="fa fa-bars"></i>
             </button>
             
             <!-- Page Title (Dynamic optional) -->
             <h5 class="mb-0 text-secondary fw-bold d-none d-md-block"><%= controller_name.capitalize %></h5>
             
             <ul class="navbar-nav ms-auto">
                <li class="nav-item dropdown">
                  <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="me-2 d-none d-lg-inline text-dark small fw-bold">Administrator</span>
                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center border border-warning" style="width: 35px; height: 35px;">
                        <i class="fas fa-user text-warning"></i>
                    </div>
                  </a>
                  <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userDropdown">
                    <li><a class="dropdown-item" href="/"><i class="fas fa-external-link-alt fa-sm fa-fw me-2 text-gray-400"></i> View Website</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                      <%= button_to destroy_user_session_path, method: :delete, class: "dropdown-item text-danger" do %>
                         <i class="fas fa-sign-out-alt fa-sm fa-fw me-2"></i>
                         Logout
                      <% end %>
                    </li>
                  </ul>
                </li>
             </ul>
          </nav>

          <!-- Main Content -->
          <div class="container-fluid px-4 pb-5">
             <% if notice %>
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
                  <i class="fas fa-check-circle me-2"></i> <%= notice %>
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
             <% end %>
             <% if alert %>
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
                  <i class="fas fa-exclamation-circle me-2"></i> <%= alert %>
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
             <% end %>
             
             <%= yield %>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
<%= render "shared/confirmation_modal" %>