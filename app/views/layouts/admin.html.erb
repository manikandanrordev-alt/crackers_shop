<!DOCTYPE html>
<html>
  <head>
    <title>Admin - Raksh Crackers</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Bootstrap CSS (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    
    <style>
      .sidebar {
        min-height: 100vh;
        background-color: #4e73df;
        background-image: linear-gradient(180deg, #4e73df 10%, #224abe 100%);
        color: white;
        transition: width 0.3s;
      }
      .sidebar .nav-link {
        color: rgba(255,255,255,.8);
        padding: 1rem;
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .sidebar .nav-link:hover, .sidebar .nav-link.active {
        color: white;
        font-weight: bold;
        background: rgba(255,255,255,0.1);
      }
      .sidebar-brand {
        height: 4.375rem;
        text-decoration: none;
        font-size: 1.2rem;
        font-weight: 800;
        letter-spacing: 0.05rem;
        text-transform: uppercase;
        color: white;
        padding: 1.5rem 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .content-wrapper {
        background-color: #f8f9fc;
        width: 100%;
        overflow-x: hidden;
      }
      
      .sidebar.toggled {
         width: 100px !important;
      }
      .sidebar.toggled .nav-link span {
         display: none;
      }
      .sidebar.toggled .sidebar-brand-text {
         display: none;
      }
    </style>
    
    <script>
      function toggleSidebar() {
         const sidebar = document.getElementById('accordionSidebar');
         sidebar.classList.toggle('toggled');
         
         const icon = document.getElementById('sidebarToggleIcon');
         if(sidebar.classList.contains('toggled')) {
            icon.classList.remove('fa-angle-left');
            icon.classList.add('fa-angle-right');
         } else {
            icon.classList.remove('fa-angle-right');
            icon.classList.add('fa-angle-left');
         }
      }
    </script>
  </head>

  <body>
    <div class="d-flex" id="wrapper">
      <!-- Sidebar -->
      <ul class="navbar-nav sidebar sidebar-dark accordion" id="accordionSidebar" style="width: 250px;">
        <a class="sidebar-brand d-flex align-items-center justify-content-center" href="/admin">
          <div class="sidebar-brand-icon rotate-n-15">
            <i class="fas fa-fire"></i>
          </div>
          <div class="sidebar-brand-text mx-3">Raksh Admin</div>
        </a>

        <hr class="sidebar-divider my-0 bg-light opacity-25">

        <li class="nav-item <%= 'active' if controller_name == 'dashboard' %>">
          <%= link_to admin_root_path, class: "nav-link" do %>
            <i class="fas fa-fw fa-tachometer-alt"></i>
            <span>Dashboard</span>
          <% end %>
        </li>

        <hr class="sidebar-divider bg-light opacity-25">

        <li class="nav-item <%= 'active' if controller_name == 'products' %>">
          <%= link_to admin_products_path, class: "nav-link" do %>
            <i class="fas fa-fw fa-box-open"></i>
            <span>Products</span>
          <% end %>
        </li>

        <li class="nav-item <%= 'active' if controller_name == 'users' %>">
           <%= link_to admin_users_path, class: "nav-link" do %>
             <i class="fas fa-fw fa-users"></i>
             <span>Users</span>
           <% end %>
        </li>

        <li class="nav-item <%= 'active' if controller_name == 'orders' %>">
           <%= link_to admin_orders_path, class: "nav-link" do %>
             <i class="fas fa-fw fa-shopping-cart"></i>
             <span>Orders</span>
           <% end %>
        </li>
        
        <li class="nav-item <%= 'active' if controller_name == 'billing' %>">
           <%= link_to admin_billing_path, class: "nav-link" do %>
             <i class="fas fa-fw fa-cash-register"></i>
             <span>Fast Billing</span>
           <% end %>
        </li>

         <li class="nav-item <%= 'active' if controller_name == 'shop_configs' %>">
           <%= link_to admin_shop_configs_path, class: "nav-link" do %>
             <i class="fas fa-fw fa-cogs"></i>
             <span>Shop Config</span>
           <% end %>
        </li>
        
        <div class="text-center d-none d-md-inline mt-4">
            <button class="rounded-circle border-0 py-2 px-3 bg-white text-primary" id="sidebarToggle" onclick="toggleSidebar()">
               <i class="fas fa-angle-left" id="sidebarToggleIcon"></i>
            </button>
        </div>
      </ul>

      <!-- Content Wrapper -->
      <div id="content-wrapper" class="d-flex flex-column content-wrapper">
        <div id="content">
          <!-- Topbar -->
          <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow px-4">
             <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3" onclick="toggleSidebar()">
                <i class="fa fa-bars"></i>
             </button>
             
             <ul class="navbar-nav ms-auto">
                <li class="nav-item dropdown">
                  <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="me-2 d-none d-lg-inline text-gray-600 small">Admin</span>
                    <i class="fas fa-user-circle fa-2x text-gray-400"></i>
                  </a>
                  <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                    <li>
                      <%= button_to destroy_user_session_path, method: :delete, class: "dropdown-item" do %>
                         <i class="fas fa-sign-out-alt fa-sm fa-fw me-2 text-gray-400"></i>
                         Logout
                      <% end %>
                    </li>
                  </ul>
                </li>
             </ul>
          </nav>

          <!-- Main Content -->
          <div class="container-fluid">
             <% if notice %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                  <%= notice %>
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
             <% end %>
             <% if alert %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                  <%= alert %>
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
             <% end %>
             
             <%= yield %>
          </div>
        </div>
      </div>
    </div>
    <!-- Bootstrap Bundle with Popper (CDN) -->

  </body>
</html>
<%= render "shared/confirmation_modal" %>