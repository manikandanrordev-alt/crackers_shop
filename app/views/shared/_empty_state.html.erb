<div class="empty-state text-center py-5">
  <div class="mb-4">
    <i class="<%= icon %> fa-4x text-gray-300"></i>
  </div>
  <h4 class="text-gray-800 mb-2"><%= title %></h4>
  <p class="text-gray-500 mb-4"><%= description %></p>
  <% if local_assigns[:action_path] && local_assigns[:action_text] %>
    <%= link_to action_text, action_path, class: "btn btn-primary rounded-pill px-4" %>
  <% end %>
</div>
