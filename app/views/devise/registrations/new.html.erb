<ul class="floating-shapes">
  <li></li><li></li><li></li><li></li><li></li>
  <li></li><li></li><li></li><li></li><li></li>
</ul>

<div class="container">
  <div class="row justify-content-center align-items-center" style="min-height: 100vh;">
    <div class="col-md-5 col-lg-4">
      <div class="auth-card p-4">
        <div class="text-center mb-4">
          <div class="bg-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 60px; height: 60px;">
             <i class="fas fa-user-plus fa-2x text-primary"></i>
          </div>
          <h3 class="fw-bold text-dark">Join Us!</h3>
          <p class="text-muted small">Create your account to start shopping</p>
        </div>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="mb-3">
            <div class="input-group">
              <span class="input-group-text bg-light border-0"><i class="fas fa-envelope text-muted"></i></span>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control bg-light border-0", placeholder: "Email Address" %>
            </div>
          </div>

          <div class="mb-3">
             <div class="input-group">
              <span class="input-group-text bg-light border-0"><i class="fas fa-lock text-muted"></i></span>
              <%= f.password_field :password, autocomplete: "new-password", class: "form-control bg-light border-0", placeholder: "Password (#{@minimum_password_length} char min)" %>
            </div>
          </div>

          <div class="mb-3">
             <div class="input-group">
              <span class="input-group-text bg-light border-0"><i class="fas fa-lock text-muted"></i></span>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control bg-light border-0", placeholder: "Confirm Password" %>
            </div>
          </div>

          <div class="d-grid mb-3">
            <%= f.submit "Sign Up", class: "btn btn-auth text-white fw-bold shadow-sm" %>
          </div>
        <% end %>

        <div class="text-center mt-4">
          <p class="small text-muted mb-0">Already have an account? 
            <%= link_to "Log in", new_session_path(resource_name), class: "fw-bold text-primary text-decoration-none" %>
          </p>
          <div class="mt-3">
             <a href="/" class="text-muted small text-decoration-none"><i class="fas fa-arrow-left me-1"></i> Back to Shop</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
