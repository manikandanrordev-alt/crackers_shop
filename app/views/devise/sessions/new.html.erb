<ul class="floating-shapes">
  <li></li><li></li><li></li><li></li><li></li>
  <li></li><li></li><li></li><li></li><li></li>
</ul>

<div class="container">
  <div class="row justify-content-center align-items-center" style="min-height: 100vh;">
    <div class="col-md-5 col-lg-4">
      <div class="auth-card p-4">
        <div class="text-center mb-4">
          <div class="bg-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 60px; height: 60px;">
             <i class="fas fa-rocket fa-2x text-primary"></i>
          </div>
          <h3 class="fw-bold text-dark">Welcome Back!</h3>
          <p class="text-muted small">Sign in to continue your celebration</p>
        </div>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
          <div class="mb-3">
            <div class="input-group">
              <span class="input-group-text bg-light border-0"><i class="fas fa-envelope text-muted"></i></span>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control bg-light border-0", placeholder: "Email Address" %>
            </div>
          </div>

          <div class="mb-3">
             <div class="input-group">
              <span class="input-group-text bg-light border-0"><i class="fas fa-lock text-muted"></i></span>
              <%= f.password_field :password, autocomplete: "current-password", class: "form-control bg-light border-0", placeholder: "Password" %>
            </div>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div class="form-check">
                <%= f.check_box :remember_me, class: "form-check-input" %>
                <%= f.label :remember_me, class: "form-check-label small text-muted" %>
              </div>
              <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
                <%= link_to "Forgot Password?", new_password_path(resource_name), class: "small text-decoration-none" %>
              <% end %>
            </div>
          <% end %>

          <div class="d-grid mb-3">
            <%= f.submit "Log In", class: "btn btn-auth text-white fw-bold shadow-sm" %>
          </div>
        <% end %>

        <div class="text-center mt-4">
          <p class="small text-muted mb-0">Don't have an account? 
            <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
              <%= link_to "Sign up", new_registration_path(resource_name), class: "fw-bold text-primary text-decoration-none" %>
            <% end %>
          </p>
          <div class="mt-3">
             <a href="/" class="text-muted small text-decoration-none"><i class="fas fa-arrow-left me-1"></i> Back to Shop</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
